# Copy to .env. Never commit the populated file.
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-with-a-random-password
LITELLM_MASTER_KEY=replace-with-a-random-admin-key

# Loopback ports are configurable to avoid collisions on development machines.
GATEWAY_HOST_PORT=4000
KEYCLOAK_HOST_PORT=8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Provider credentials remain on the gateway host.
OPENROUTER_API_KEY=

# Corporate OIDC settings. The development values work with the optional
# Keycloak profile; production should use HTTPS and the external IdP.
OIDC_ISSUER_URL=http://localhost:8080/realms/enterprise-ai
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/enterprise-ai/.well-known/openid-configuration
OIDC_JWKS_URL=http://keycloak:8080/realms/enterprise-ai/protocol/openid-connect/certs
OIDC_CLIENT_ID=enterprise-ai-cli
OIDC_ALLOWED_CLIENT_IDS=enterprise-ai-cli,example-service
OIDC_AUDIENCE=enterprise-ai-gateway
OIDC_GROUP_CLAIM=groups
OIDC_ROLE_CLAIM=realm_access.roles
OIDC_SERVICE_CLAIM=identity_type
OIDC_REQUIRED_SCOPES=
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_JWKS_TTL_SECONDS=3600
OIDC_JWKS_UNKNOWN_KID_REFRESH_SECONDS=30
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_ALLOW_HTTP=true
OIDC_POLICY_FILE=/app/policy.yaml

# Freshness limit for the generated, approved raw-model routes.
APPROVED_CATALOG_MAX_AGE_SECONDS=86400
OPENROUTER_POLICY_MODELS=openrouter/*,general-fast,general-quality,coding-fast,coding-frontier,cheap-batch

# Stable aliases can be repointed without a client change.
GENERAL_FAST_MODEL=openrouter/google/gemini-3.7-flash
GENERAL_QUALITY_MODEL=openrouter/anthropic/claude-sonnet-5
CODING_FAST_MODEL=openrouter/qwen/qwen3-coder-next
CODING_FRONTIER_MODEL=openrouter/openai/gpt-5.6-luna
CHEAP_BATCH_MODEL=openrouter/deepseek/deepseek-v4-flash-0731
GENERAL_FAST_API_BASE=https://openrouter.ai/api/v1
GENERAL_QUALITY_API_BASE=https://openrouter.ai/api/v1
CODING_FAST_API_BASE=https://openrouter.ai/api/v1
CODING_FRONTIER_API_BASE=https://openrouter.ai/api/v1
CHEAP_BATCH_API_BASE=https://openrouter.ai/api/v1
GENERAL_FAST_API_KEY=
GENERAL_QUALITY_API_KEY=
CODING_FAST_API_KEY=
CODING_FRONTIER_API_KEY=
CHEAP_BATCH_API_KEY=

# OpenCode organization plugin (client-side, no provider credential).
ENTERPRISE_AI_GATEWAY_URL=http://localhost:4000/v1
ENTERPRISE_AI_OIDC_ISSUER=http://localhost:8080/realms/enterprise-ai
ENTERPRISE_AI_OIDC_CLIENT_ID=enterprise-ai-cli
ENTERPRISE_AI_OIDC_SCOPE=openid profile email offline_access
