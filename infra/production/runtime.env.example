# Inventory only. Copy to an external secret-manager-controlled path such as
# /run/secrets/enterprise-ai/runtime.env, populate it there, and set mode 0600.
# Blank secrets are intentional so accidental use fails closed.

POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=
GATEWAY_HOST_PORT=4000

# Secret-managed gateway connection string. Percent-encode reserved characters
# in its username/password; keep POSTGRES_PASSWORD above as the matching raw value.
DATABASE_URL=postgresql://litellm:replace-with-percent-encoded-password@postgres:5432/litellm

# Required immutable release artifact. Tags alone are rejected by the runbook;
# use the registry digest recorded by CI/release management.
GATEWAY_IMAGE=registry.example.com/enterprise-ai/gateway@sha256:replace-with-promoted-digest

# Bootstrap/accounting management credential. Never issue this to a client.
LITELLM_MASTER_KEY=

# Provider credentials remain server-side.
OPENROUTER_API_KEY=

# Must be no greater than catalog/catalog-policy.yaml max_stale_seconds.
APPROVED_CATALOG_MAX_AGE_SECONDS=86400

# Production identity configuration. The example host is intentionally inert.
OIDC_ISSUER_URL=https://id.example.com/realms/enterprise-ai
OIDC_AUDIENCE=enterprise-ai-gateway
OIDC_CLIENT_ID=enterprise-ai-cli
OIDC_ALLOWED_CLIENT_IDS=enterprise-ai-cli,example-service
OIDC_GROUP_CLAIM=groups
OIDC_ROLE_CLAIM=roles
OIDC_SERVICE_CLAIM=identity_type
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_REQUIRED_SCOPES=
OIDC_JWKS_TTL_SECONDS=3600
OIDC_JWKS_UNKNOWN_KID_REFRESH_SECONDS=30
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_ALLOW_HTTP=false

# Usually leave these blank and use discovery from OIDC_ISSUER_URL. Set them only
# for a reviewed split-horizon/private-network deployment.
OIDC_DISCOVERY_URL=
OIDC_JWKS_URL=

# Stable aliases can move between OpenRouter, a direct vendor, and a local
# OpenAI-compatible endpoint without client changes. The gateway derives each
# route's privacy backend from its resolved model adapter; there is no separate
# alias allowlist to keep synchronized.
GENERAL_FAST_MODEL=openrouter/replace-with-approved-model
GENERAL_QUALITY_MODEL=openrouter/replace-with-approved-model
CODING_FAST_MODEL=openrouter/replace-with-approved-model
CODING_FRONTIER_MODEL=openrouter/replace-with-approved-model
CHEAP_BATCH_MODEL=openrouter/replace-with-approved-model
GENERAL_FAST_API_BASE=https://openrouter.ai/api/v1
GENERAL_QUALITY_API_BASE=https://openrouter.ai/api/v1
CODING_FAST_API_BASE=https://openrouter.ai/api/v1
CODING_FRONTIER_API_BASE=https://openrouter.ai/api/v1
CHEAP_BATCH_API_BASE=https://openrouter.ai/api/v1
GENERAL_FAST_API_KEY=
GENERAL_QUALITY_API_KEY=
CODING_FAST_API_KEY=
CODING_FRONTIER_API_KEY=
CHEAP_BATCH_API_KEY=
